@page
@model Razor.Pages.Tasks.IndexModel

@{
	ViewData["Title"] = "Список дел";
}

<div class="flex justify-center text-gray-800 p-5 text-2xl font-bold">
    <h1>
        @if (Model.Category.HasValue)
        {
            @:Задачи: @Model.Category.GetDisplayName()
        }
        else
        {
            @:Все задачи
        }

        @if (Model.Status == "active")
        {
            @:(незавершенные)
        }
        else if (Model.Status == "completed")
        {
            @:(завершенные)
        }
    </h1>
</div>

<div class="flex justify-between items-start mb-2">
    <form method="get">

        <input type="hidden" asp-for="Category" />

        <div class="flex gap-4">
            <label title="активные">
                <input type="radio"
                       name="status"
                       value="active"
                       onchange="this.form.submit()"
                @(Model.Status == "active" ? "checked" : "") />

                !
            </label>

            <label title="завершенные">
                <input type="radio"
                       name="status"
                       value="completed"
                       onchange="this.form.submit()"
                @(Model.Status == "completed" ? "checked" : "") />

                ✔
            </label>
        </div>
        <div>
            <div>
                <label asp-for="Sort" class="sr-only">Сортировка:</label>

                <select asp-for="Sort"
                        asp-items="Html.GetEnumSelectList<SortOrder>()"
                        onchange="this.form.submit()">
                </select>
            </div>
        </div>

        <div class="relative w-full max-w-md">
            <input type="search"
                   asp-for="Search"
                   placeholder="Поиск..."
                   hx-get="/Tasks?handler=Search"
                   hx-trigger="input delay:500ms"
                   hx-target="#tasks"
                   hx-include="closest form"
                   hx-push-url="true"
                   class="w-full px-4 py-2 pl-10 text-sm text-gray-700 bg-white
            border border-gray-100
            focus:outline-none focus:ring-2 focus:ring-gray-300 focus:border-transparent
            hover:border-gray-200
            transition-colors duration-200
            placeholder:text-gray-400" />

            <!-- Иконка лупы слева -->
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400 pointer-events-none"
                 xmlns="http://www.w3.org/2000/svg"
                 width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
            </svg>
        </div>
    </form>

    @if (Model.Category.HasValue || !string.IsNullOrWhiteSpace(Model.Status))
    {
        <a asp-page="/Tasks/Index" class="button-link">
            Показать все
        </a>
    }
</div>


<a asp-page="./Create" title="Добавить задачу">
    <svg width="24"
         height="24"
         viewBox="0 0 24 24"
         fill="none"
         aria-hidden="true">

        <!-- Круг -->
        <circle cx="12" cy="12" r="10" fill="#B4534B" />

        <!-- Плюс -->
        <path d="M12 7v10M7 12h10"
              stroke="white"
              stroke-width="2"
              stroke-linecap="round" />

    </svg>
</a>

<!-- вывод задач -->
<div id="tasks" class="mt-2">
    <partial name="_TaskList" model="Model" />
</div>


