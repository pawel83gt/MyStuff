@model string?

@switch (Model)
{
    case "Work":
        <!-- Работа — портфель -->
        <svg width="24"
             height="24"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">
            <rect x="3" y="7" width="18" height="13" rx="2" />
            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            <path d="M3 12h18" />
            <path d="M10 12v2h4v-2" />
        </svg>
        break;

    case "Home":
        <!-- Дом -->
        <svg width="24"
             height="24"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">
            <path d="M3 10.5L12 3l9 7.5" />
            <path d="M5 9.5V21h14V9.5" />
            <path d="M9 21v-6h6v6" />
        </svg>
        break;

    case "Study":
        <!-- Учёба — книга -->
        <svg width="24"
             height="24"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">
            <path d="M4 5a3 3 0 0 1 3-3h13v18H7a3 3 0 0 0-3 3z" />
            <path d="M4 5v16" />
            <path d="M7 2v18" />
            <path d="M11 6h6" />
            <path d="M11 10h6" />
        </svg>
        break;

    case "Entertainment":
        <!-- Развлечения — геймпад -->
        <svg width="24"
             height="24"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">
            <path d="M7 8h10a5 5 0 0 1 4.8 6.4l-1.2 4
            a2.5 2.5 0 0 1-4.6.5L14.5 16h-5l-1.5 2.9
            a2.5 2.5 0 0 1-4.6-.5l-1.2-4A5 5 0 0 1 7 8z" />
            <path d="M8 11v4" />
            <path d="M6 13h4" />
            <circle cx="16.5" cy="12" r="1" />
            <circle cx="18.5" cy="14" r="1" />
        </svg>
        break;

    case "Other":
        <!-- Другое — пазл -->
        <svg width="24"
             height="24"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">
            <path d="M9 3h3a2 2 0 1 1 4 0h3v5a2 2 0 1 1 0 4v3h-5
            a2 2 0 1 0-4 0H5v-3a2 2 0 1 0 0-4V8h4V3z" />
        </svg>
        break;
}